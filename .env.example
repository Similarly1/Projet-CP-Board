# Port d'écoute du serveur backend
PORT=3000
NODE_ENV=development

# Protection d'accès (optionnelle - mot de passe simple de session)
APP_PASSWORD=

# Configuration ChurchTools
# Exemple: https://mon-eglise.church.tools
CHURCHTOOLS_BASE_URL=https://mon-eglise.church.tools
CHURCHTOOLS_API_TOKEN=ct_token_xyz
CHURCHTOOLS_COMMITTEE_GROUP_ID=12

# Configuration Infomaniak kDrive (API v3)
KDRIVE_API_BASE_URL=https://api.infomaniak.com/3
KDRIVE_API_TOKEN=kdrive_token_xyz
KDRIVE_DRIVE_ID=123456
# ID du dossier racine "Comité / Séances" sur kDrive
KDRIVE_ROOT_FOLDER_ID=789012
